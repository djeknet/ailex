{
  "amazon.com": {
    "category": "ecommerce",
    "pageTypes": {
      "product": {
        "selectors": ["#productTitle", "h1#title", "span#productTitle", "meta[name='title']"],
        "prompts": [
          { "text": "Проанализируй отзывы: отсей фейковые и составь честный список плюсов и минусов.", "capabilities": ["context"] },
