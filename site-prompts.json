      "search": {
        "selectors": ["span.a-color-state", "#search", "title"],
        "prompts": [
          { "text": "Выбери 3 лучших товара со страницы по соотношению цена/рейтинг.", "capabilities": ["context"] },
          { "text": "Есть ли здесь товары с подозрительно накрученными отзывами?", "capabilities": ["context"] }
