### 7.1 Обязательные проверки производительности
```typescript
// ВСЕГДА измеряй время выполнения критических функций
const measurePerformance = <T extends (...args: any[]) => any>(
  fn: T, 
  name: string,
  threshold: number = 100
): T => {
  return (async (...args: Parameters<T>) => {
    const start = performance.now();
    const result = await fn(...args);
    const end = performance.now();
    
    const duration = end - start;
    if (duration > threshold) {
      console.warn(`⚠️ ${name} took ${duration.toFixed(2)}ms (threshold: ${threshold}ms)`);
    }
    
    return result;
  }) as T;
};

// Используй для критических функций
const optimizedDataProcessor = measurePerformance(
  processLargeDataSet, 
  'Data Processing',
  50
);
```

### 7.2 Memory management
```typescript
// ВСЕГДА очищай listeners и observers
class ExtensionLifecycleManager {
  private observers: MutationObserver[] = [];
  private listeners: Array<{
    element: Element | Document | Window;
    event: string;
    handler: EventListener;
  }> = [];
  private timeouts: NodeJS.Timeout[] = [];
  private intervals: NodeJS.Timeout[] = [];

  addObserver(observer: MutationObserver) {
    this.observers.push(observer);
    return observer;
  }

  addEventListener<T extends Element | Document | Window>(
    element: T,
    event: string,
    handler: EventListener,
    options?: AddEventListenerOptions
  ) {
    element.addEventListener(event, handler, options);
    this.listeners.push({ element, event, handler });
  }

  setTimeout(callback: () => void, delay: number) {
    const timeout = setTimeout(callback, delay);
    this.timeouts.push(timeout);
    return timeout;
  }

  setInterval(callback: () => void, delay: number) {
    const interval = setInterval(callback, delay);
    this.intervals.push(interval);
    return interval;
  }

  destroy() {
    // Очищаем observers
    this.observers.forEach(observer => observer.disconnect());
    
    // Очищаем event listeners
    this.listeners.forEach(({ element, event, handler }) => {
      element.removeEventListener(event, handler);
    });
    
    // Очищаем timeouts и intervals
    this.timeouts.forEach(clearTimeout);
    this.intervals.forEach(clearInterval);
    
    // Сбрасываем массивы
    this.observers = [];
    this.listeners = [];
    this.timeouts = [];
    this.intervals = [];
  }
}
```


