### 5.4 Скрипты упаковки и проверки

#### 5.4.1 Скрипт упаковки расширения
```javascript
// scripts/package-extension.js
const fs = require('fs-extra');
const path = require('path');
const archiver = require('archiver');

async function packageExtension() {
  const distPath = path.resolve('dist');
  const packagePath = path.resolve('extension-package');
  
  console.log('📦 Создание финального пакета расширения...');
  
  // Создаем папку для финального пакета
  await fs.ensureDir(packagePath);
  await fs.emptyDir(packagePath);
  
  // Копируем только необходимые файлы
  await fs.copy(distPath, packagePath, {
    filter: (src) => {
      // Исключаем ненужные файлы
      return !src.includes('.map') && 
             !src.includes('hot-reload') &&
             !src.includes('vite') &&
             !src.includes('.DS_Store');
    }
  });
  
  // Проверяем финальную структуру
  const files = await fs.readdir(packagePath);
  console.log('✅ Финальные файлы:', files);
  
  // Создаем ZIP архив для Chrome Web Store
  const output = fs.createWriteStream('extension.zip');
  const archive = archiver('zip', { zlib: { level: 9 } });
  
  archive.pipe(output);
  archive.directory(packagePath, false);
  await archive.finalize();
  
  console.log('✅ Extension packaged successfully → extension.zip');
  
  // Показываем размер финального архива
  const stats = await fs.stat('extension.zip');
  console.log(`📊 Archive size: ${(stats.size / 1024 / 1024).toFixed(2)} MB`);
}

packageExtension().catch(console.error);
```

#### 5.4.2 Pre-build проверки
```javascript
// scripts/pre-build-check.js
const fs = require('fs');
const path = require('path');
const glob = require('glob');

function getAllTsFiles(dir) {
  return glob.sync(`${dir}/**/*.{ts,tsx}`, { ignore: '**/node_modules/**' });
}

// Проверяем отсутствие console.* в production коде
function checkForConsole() {
  console.log('🔍 Проверка console statements...');
  const srcPath = path.resolve('src');
  const files = getAllTsFiles(srcPath);
  let hasConsole = false;
  
  files.forEach(file => {
    const content = fs.readFileSync(file, 'utf8');
    const consoleRegex = /console\.(log|warn|error|info|debug)/g;
    const matches = content.match(consoleRegex);
    
    if (matches && !content.includes('if (__DEV__)')) {
      console.warn(`⚠️ Found console statements in ${file}:`, matches);
      hasConsole = true;
    }
  });
  
  return hasConsole;
}

// Проверяем размер исходных файлов
function checkSourceSize() {
  console.log('📏 Проверка размера исходных файлов...');
  const srcPath = path.resolve('src');
  const files = getAllTsFiles(srcPath);
  
  files.forEach(file => {
    const stats = fs.statSync(file);
    const sizeKb = stats.size / 1024;
    
    if (sizeKb > 250) {
      console.warn(`⚠️ Large file detected: ${file} (${sizeKb.toFixed(2)}KB)`);
    }
  });
}

// Основная функция проверки
async function runChecks() {
  console.log('🚀 Running pre-build checks...');
  
  const hasConsole = checkForConsole();
  checkSourceSize();
  
  if (hasConsole) {
    console.warn('⚠️ Warning: Console statements found in source code');
    console.log('ℹ️ They will be removed in production build');
  }
  
  console.log('✅ Pre-build checks completed');
}

runChecks().catch(console.error);
```

#### 5.4.3 Валидация финального пакета
```javascript
// scripts/validate-package.js
const fs = require('fs-extra');
const path = require('path');

async function validatePackage() {
  const packagePath = path.resolve('extension-package');
  
  console.log('🔍 Валидация финального пакета...');
  
  // Проверяем обязательные файлы
  const requiredFiles = ['manifest.json', 'background.js'];
  for (const file of requiredFiles) {
    const filePath = path.join(packagePath, file);
    if (!await fs.pathExists(filePath)) {
      throw new Error(`❌ Missing required file: ${file}`);
    }
  }
  
  // Проверяем отсутствие комментариев в JS файлах
  const jsFiles = await fs.readdir(packagePath);
  for (const file of jsFiles.filter(f => f.endsWith('.js'))) {
    const content = await fs.readFile(path.join(packagePath, file), 'utf8');
    if (content.includes('//') || content.includes('/*')) {
      console.warn(`⚠️ Comments found in ${file}`);
    }
  }
  
  console.log('✅ Package validation completed');
}

validatePackage().catch(console.error);
```

