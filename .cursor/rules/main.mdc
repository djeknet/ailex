### 3.3 State Management
```typescript
// ВСЕГДА используй ТОЛЬКО Zustand с persist middleware
import { create } from 'zustand';
import { persist, createJSONStorage } from 'zustand/middleware';

interface ExtensionState {
  settings: UserSettings;
  theme: 'light' | 'dark' | 'system';
  isLoading: boolean;
  setTheme: (theme: 'light' | 'dark' | 'system') => void;
  updateSettings: (settings: Partial<UserSettings>) => void;
}

export const useExtensionStore = create<ExtensionState>()(
  persist(
    (set) => ({
      settings: DEFAULT_SETTINGS,
      theme: 'system',
      isLoading: false,
      setTheme: (theme) => set({ theme }),
      updateSettings: (newSettings) => 
        set((state) => ({ 
          settings: { ...state.settings, ...newSettings } 
        })),
    }),
    {
      name: 'extension-storage',
      storage: createJSONStorage(() => ({
        getItem: async (name) => {
          const result = await chrome.storage.local.get(name);
          return result[name] || null;
        },
        setItem: async (name, value) => {
          await chrome.storage.local.set({ [name]: value });
        },
        removeItem: async (name) => {
          await chrome.storage.local.remove(name);
        },
      }))
    }
  )
);

// НИКОГДА не используй Redux для браузерных расширений
```

### 3.4 Условная компиляция и оптимизация
```typescript
// ВСЕГДА различай dev/production окружения в коде
const isDevelopment = process.env.NODE_ENV === 'development';
const isProduction = process.env.NODE_ENV === 'production';

// Условная логика для отладки (будет удалена в production)
if (__DEV__) {
  console.log('Development mode active');
  window.__EXTENSION_DEBUG__ = true;
}

// Условные импорты для dev-only функций
if (__DEV__) {
  import('./dev-tools').then(devTools => {
    devTools.initializeDevMode();
  });
}

// Production конфигурация без отладочной информации
export const config = isProduction ? {
  apiUrl: 'https://api.production.com',
  debug: false,
  enableLogging: false
} : {
  apiUrl: 'https://api.dev.com', 
  debug: true,
  enableLogging: true
};

// Условные console.* записи (только для development)
const log = (__DEV__ && console.log) || (() => {});
const warn = (__DEV__ && console.warn) || (() => {});
const error = console.error; // Ошибки всегда логируем

// Использование условного логирования
log('This will be removed in production');
warn('Development warning');
error('This error will remain in production');
```

